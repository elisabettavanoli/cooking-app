# Supabase — create a free project at https://supabase.com/dashboard
# then Project Settings -> API and copy:
#   - "Project URL"        -> VITE_SUPABASE_URL
#   - "Project API keys" / anon public -> VITE_SUPABASE_ANON_KEY
#
# Copy this file to `.env.local` (git-ignored) and fill in the real values.
# With both unset the app runs fully local (no login), exactly as before.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
